    > _logo
    > _contactbtn
include ../../../pug/_if
include ../../../pug/_foreach

.menutop__wrap.wrapper
    div.menutop#menutop

        .menutop__gamburger
            div.gamburger.gamburger_js

        nav.menutop__nav

            ul.navlist.navlist-lt
                +foreach("$modules","$item",false,false)
                    | {set $active = ''}
                    +if("$module == $item")
                        | {set $active = 'active'}
                    li(class="{$active}"): a(href="/modules/{$item}") {$item}
